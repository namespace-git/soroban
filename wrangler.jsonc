// そろばん Web 版 — Cloudflare Workers の設定。`npx wrangler deploy`（Workers Builds の Deploy command）が読む。
// 1 本の Worker で「画面（静的アセット）＋ API ＋ 定期実行」をやる。入口は worker/index.ts。手順は docs/web/01-setup.md の 2 節。
//
// **このファイルに秘密の値を書かない（このリポジトリは Public）。** ここに書いてよいのは、ブラウザにも出る公開の値だけ。
//   * VAPID_PRIVATE_KEY / SECRET_KEYS / VAPID_SUBJECT（メールアドレスが入る）などの秘密は、Cloudflare の画面
//     （Settings → Variables and Secrets）で **Secret 型**として入れる。
//   * Secret 型は `wrangler deploy` で消えない（wrangler は Secret のバインディングを必ず引き継ぐ。ファイルに無くても）。
//   * 画面で入れた「プレーンテキスト」の変数は、既定ではデプロイのたびに消される（このファイルが正になるため）。
//     下の `keep_vars: true` で、画面で入れたプレーンテキストの変数もデプロイで消えないようにしてある。
{
  "name": "soroban",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // postgres.js が Node の API を使う
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // pnpm build:web の出力。_headers（セキュリティヘッダー）もここに出て、画面のファイルにそのまま効く
    "directory": "./dist-web",
    "binding": "ASSETS",
    // 知らないパス（/sales など。画面の中の遷移）は index.html を返す
    "not_found_handling": "single-page-application",
    // /api/* は必ず Worker の処理へ。それ以外は Worker を通さず、画面のファイルを直接返す
    "run_worker_first": ["/api/*"]
  },

  // 定期実行（同じ Worker の scheduled）。期限切れの取り込み要求の片付け・通知の送信・17TRACK の確認
  "triggers": { "crons": ["*/5 * * * *"] },

  // DB への接続（Hyperdrive。pnpm setup:gateway が作ったもの。id は秘密ではない。接続のパスワードは Hyperdrive の中にだけある）。
  // **画面（Settings → Bindings）で Hyperdrive を結び付けるだけでは足りない。** 結び付けは、このファイルに無いと次のデプロイで消える。
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9751b25c5b69461a8f5f6507d8bcfb9a" }],

  // Worker（/api と定期実行）を DB（Supabase・シンガポール）の近くで動かす。画面のファイル（assets）は今までどおり近くの拠点から返る。
  // API 1 本で DB と 10 回前後やりとりする（postgres.js は引数のある SQL ごとに describe で 1 往復増える）ので、
  // 大阪で動かすと 1 往復 70ms 前後 × 回数がそのまま待ち時間になっていた（2026-10-18 の実測：ふつうの読み出しで 0.8〜1 秒、ホームで 3〜6 秒）
  "placement": { "region": "aws:ap-southeast-1" },

  // workers.dev の URL で公開する（https://soroban.<アカウント>.workers.dev）。ブランチごとのプレビュー URL は作らない
  "workers_dev": true,
  "preview_urls": false,

  // 画面で入れたプレーンテキストの変数をデプロイで消さない（Secret 型は、この指定に関わらず消えない）
  "keep_vars": true,
  // ダッシュボードの Logs に残す（最初のうちの不具合を追うため。ログに秘密・個人データは出さない作り）
  "observability": { "enabled": true },

  // 公開してよい値だけ（Supabase の Project URL と、ブラウザにも出る anon / publishable キー）
  "vars": {
    "SUPABASE_URL": "https://erugfqqphgdaebpvbzhs.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_ee__exEHtnN24f6tHh0euw_9syzE5_7"
  }
}
